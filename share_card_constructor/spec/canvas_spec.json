  "dynamicFields": {
    "ascensionCount": {
      "box": "tierBadge",
      "format": "★ × {integer}",
      "portraitFontPx": 47,
      "squareFontPx": 38
    },
    "lifetimeBaked": {
      "box": "lifetimeBaked",
      "format": "compact",
      "examples": [
        "4.2M",
        "18.4K",
        "1.2B",
        "987T"
      ],
      "maxDecimals": 1,
      "dropTrailingZero": true,
      "fit": "shrink-to-fit, never wrap",
      "portraitFontPx": {
        "max": 148,
        "min": 78
      },
      "squareFontPx": {
        "max": 116,
        "min": 66
      }
    },
    "rank": {
      "box": "rankCard",
      "format": "#{integer}",
      "missing": "hide rankCard; expand CPS to x=78 width=924"
    },
    "rankPercent": {
      "box": "rankCard",
      "format": "TOP {percent}%",
      "optional": true
    },
    "cps": {
      "box": "cpsCard",
      "format": "compact",
      "fit": "shrink-to-fit, never wrap"
    },
    "first_name": {
      "box": "player",
      "overflow": "ellipsis by measured pixel width",
      "maxWidthPx": 770
    },
    "avatar": {
      "box": "player",
      "shape": "circle",
      "source": "Telegram photo or initial fallback"
    },
    "refUrl": {
      "rendering": "Do not rasterize URL into image; attach to Telegram caption/text or inline button."
    }
  },
